# Mẫu cấu hình cục bộ. Copy thành .env rồi điền giá trị của riêng bạn:
#
#   cp .env.example .env
#
# File .env không bao giờ được commit. Không đặt mật khẩu thật vào file mẫu này.
#
# Luôn bọc giá trị trong dấu nháy kép: chuỗi kết nối chứa dấu ; mà shell hiểu
# là dấu tách lệnh khi bạn chạy "source .env".

# Mật khẩu PostgreSQL cho môi trường phát triển. Tự sinh một chuỗi ngẫu nhiên:
#
#   openssl rand -base64 24
#
POSTGRES_PASSWORD="doi-thanh-mat-khau-cua-ban"

# Chuỗi kết nối cho API và cho lệnh dotnet ef.
# Dấu gạch dưới đôi là quy ước của .NET để ánh xạ sang ConnectionStrings:Default.
# Phần Password phải khớp với POSTGRES_PASSWORD ở trên.
ConnectionStrings__Default="Host=localhost;Port=5432;Database=civicflow_dev;Username=civicflow;Password=doi-thanh-mat-khau-cua-ban"

# Khoá ký JWT, ánh xạ sang Jwt:SecretKey. Sinh khoá riêng của bạn:
#
#   openssl rand -base64 48
#
# Tối thiểu 32 byte vì HMAC-SHA256 yêu cầu khoá 256 bit.
# Ứng dụng không có khoá mặc định — thiếu biến này thì API dừng ngay lúc khởi
# động, để không bao giờ chạy với khoá nằm sẵn trong mã nguồn.
Jwt__SecretKey="sinh-khoa-cua-rieng-ban-toi-thieu-32-byte"
